# Screenshots originais usados como fonte pra seção "Nossa História" —
# as versões otimizadas que o site realmente usa ficam em assets/img/historia/
/FotosDeoutrosServers/

# Clipes brutos do Medal.tv (alta taxa de bits, ~250MB) — as versões
# recomprimidas pro site ficam em assets/video/clipes/
/clipes/

# Modpack (400-500MB) — grande demais pro git. Sobe como anexo de uma
# GitHub Release e liga o link em js/script.js (CONFIG.modpackLink).
/mods.rar
/modpack-wgusmares.zip

# Jars soltos do modpack (centenas de MB) e config local do Claude Code —
# nada disso deve ir pro repositório nem ser servido publicamente.
/mods/
/.claude/
